{
  "name": "xenios-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:pages": "XENIOS_STATIC_EXPORT=1 next build",
    "build:credits": "node scripts/build-credits.mjs",
    "build:discussions": "node scripts/mirror-compat-data.mjs",
    "build:compat-data": "node scripts/rebuild-compatibility-data.mjs",
    "build:release-data": "node scripts/repair-release-builds.mjs",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mirror:compat-data": "node scripts/mirror-compat-data.mjs",
    "sync:public-data": "node scripts/sync-public-compat-data.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
